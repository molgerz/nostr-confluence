# Gruppen-Relay (NIP-29). Default ist das lokale Relay aus scripts/dev-relay-up.sh
VITE_RELAY_URL=ws://localhost:8080

# Relays, von denen Profile (Kind 0) geholt werden, kommagetrennt.
# Ein NIP-29-Relay nimmt Kind 0 nicht an — jedes Event braucht dort einen
# h-Tag — deshalb kommen Profile von den Relays der Nutzerin.
# Lokal zum Ausprobieren:  nak serve --port 10577
# Produktiv z. B.:         wss://purplepag.es,wss://relay.damus.io
VITE_PROFILE_RELAYS=

# Blossom-Server für Anhänge (Bilder, Dateien). Nostr speichert keine Dateien;
# der Blob liegt dort unter seinem sha256, im Event steht nur die URL.
# Lokal zum Ausprobieren:  node scripts/dev-blossom.mjs
VITE_BLOSSOM_SERVER=
